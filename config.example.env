# Taaj — configuration template (production / staging).
# Every setting the server reads, as environment variables (ASP.NET Core: ":" becomes "__").
# Put real values in the host's secret store or environment, never in a file in the repository.
# In Development, use `dotnet user-secrets` instead (secrets are never read from appsettings.json).

ASPNETCORE_ENVIRONMENT=Production

# ---- Required: the server refuses to start without these ----
ConnectionStrings__DefaultConnection=Server=<sql-server>;Database=<db>;User Id=<least-privilege-user>;Password=<secret>;Encrypt=True;TrustServerCertificate=False
# Long random value (32+ characters), used to sign test-gateway callbacks.
Payments__WebhookSecret=<random-64-chars>
# The real domain(s), separated by ";" (no "*").
AllowedHosts=taaj.example.com;www.taaj.example.com
# Public https address used in email links (password reset, confirmation, invitations).
App__PublicBaseUrl=https://taaj.example.com

# ---- Payments (Paymob). Test mode = the test keys from the Paymob dashboard ----
Payments__Provider=Paymob
Payments__Paymob__SecretKey=<from Paymob>
Payments__Paymob__PublicKey=<from Paymob>
Payments__Paymob__HmacSecret=<from Paymob>
# Comma separated integration IDs (card, mobile wallet...)
Payments__Paymob__IntegrationIds=<id1>,<id2>
# Optional, default https://accept.paymob.com
# Payments__Paymob__ApiBase=

# ---- Email: one of SMTP or SendGrid ----
Email__From=test@dentag.com
Email__FromName=Taaj
Email__Smtp__Host=<smtp host>
Email__Smtp__Port=587
Email__Smtp__User=<user>
Email__Smtp__Password=<secret>
Email__Smtp__EnableSsl=true
# Email__SendGrid__ApiKey=<secret>

# ---- First admin account (created once, on an empty database) ----
Bootstrap__AdminEmail=<admin email>
Bootstrap__AdminPassword=<strong password, change after first sign-in>

# ---- Optional ----
# Days after delivery before an order completes by itself (1-60, default 3)
# Orders__AutoCompleteDays=3
# Arabic font families for PDFs (Linux: install fonts-noto-core). Default: Tahoma,Arial on Windows, Noto Naskh Arabic on Linux.
# Documents__Fonts=Noto Naskh Arabic
# Other sites allowed to send writes (normally none: the site and API share one origin)
# Security__AllowedOrigins=
# Staging only: start even if the settings above are incomplete (logged as critical). Never in production.
# Launch__AllowIncompleteSetup=false
